# ==========================================================
# RobotReplay
# Repository exclusions
# ==========================================================

# Python environments
.venv/
venv/
env/

# Python generated files
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/
.eggs/

# Test / analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets and environment configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp

# Development backups
backup_before_*/
**/*_before_*.py
dashboard/app_working_upload_version.py

# Large raw ROS bag recordings
*.db3
*.mcap
*.bag

# External development datasets
external_validation/

# Local controlled raw-recording workspace
scenarios/

# Temporary files
*.tmp
*.temp
*.log

# Generated upload/extraction workspaces
robotreplay_upload_*/

# Local root-level release/export archives
/*.zip
/*.sha256

# The compact reproducible example is intentionally versioned
!examples/localization_jump_rosbag.zip
